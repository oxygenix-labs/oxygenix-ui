{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "forceConsistentCasingInFileNames": true,
        /* Path mapping */
        "baseUrl": ".",
        "paths": {
            "@oxygenix-ui/core": [
                "./packages/core/src"
            ],
            "@oxygenix-ui/tokens": [
                "./packages/tokens/src"
            ],
            "@oxygenix-ui/data": [
                "./packages/data/src"
            ],
            "@oxygenix-ui/forms": [
                "./packages/forms/src"
            ],
            "@oxygenix-ui/layout": [
                "./packages/layout/src"
            ],
            "@oxygenix-ui/ui": [
                "./packages/ui/src"
            ]
        }
    },
    "include": [
        "packages"
    ],
    "references": [
        {
            "path": "./packages/core"
        },
        {
            "path": "./packages/tokens"
        },
        {
            "path": "./packages/data"
        },
        {
            "path": "./packages/forms"
        },
        {
            "path": "./packages/layout"
        },
        {
            "path": "./packages/ui"
        }
    ]
}